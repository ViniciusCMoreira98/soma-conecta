# Copie para .env.local e preencha com os valores do seu projeto Supabase
# (Settings > API). Nenhum segredo real deve ser versionado.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
# URL pública do site (usada nos redirecionamentos de autenticação)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
